{
  "name": "dsh-agent-team-ui-testing",
  "version": "0.1.6",
  "description": "Frontend GUI debugging and testing for DeepSeekHarness agents: Web/Chromium ships 44 browser_* tools (43 execution + a discovery entry) for structured GUI automation, visual comparison, dynamic frames, annotations and network debugging; 3D has a Blender viewport with mouse input, annotation and screenshots; other targets are planned.",
  "license": "MIT",
  "type": "module",
  "keywords": ["deepseek-harness", "dsh-plugin", "ui-testing", "gui-testing", "test-automation", "browser-automation", "visual-regression", "network-debugging"],
  "repository": { "type": "git", "url": "https://github.com/bloodarea/dsh-agent-team-ui-testing.git" },
  "engines": { "node": ">=22" },
  "dependencies": { "x11": "4.4.0" },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "prepack": "npm run check:client"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": ["index.js", "dist/client.js", "select-control.js", "context-menu.js", "frame-source.js", "frame-push.js", "browser-safety.js", "capture-p0.js", "annotation-capture.js", "vision-t3.js", "vision-baseline.js", "network-p0.js", "dynamic-t4.js", "cordis.patch.yml", "locale/*.json", "icon.png", "banner.png", "banner_zh.png", "docs/*.md", "docs/three-d/", "docs/images/", "docs/examples/", "core/", "targets/", "integration/", "skills/**"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  }
}
