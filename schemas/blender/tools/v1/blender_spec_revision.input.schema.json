        },
        "scene": {
          "type": "object"
        },
        "sceneJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16777216
        },
        "artifactId": {
          "$ref": "urn:dsh:blender:common:1#/$defs/artifactId"
        },
        "grantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "action",
        "grantId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "get"
        },
        "timeoutMs": {
          "$ref": "urn:dsh:blender:common:1#/$defs/timeoutMs"
        },
        "sceneId": {
          "$ref": "urn:dsh:blender:common:1#/$defs/sceneId"
