{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "apply"
        },
        "timeoutMs": {
          "$ref": "urn:dsh:blender:common:1#/$defs/timeoutMs"
        },
        "mode": {
          "enum": [
            "plan",
            "apply"
          ]
        },
        "targetId": {
          "$ref": "urn:dsh:blender:common:1#/$defs/targetId"
        },
        "generation": {
          "$ref": "urn:dsh:blender:common:1#/$defs/generation"
        },
        "expectSceneRevision": {
          "$ref": "urn:dsh:blender:common:1#/$defs/revision"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectControlRevision": {
          "$ref": "urn:dsh:blender:common:1#/$defs/revision"
        },
        "idemKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "grantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scene": {
          "type": "object"
        },
        "artifactId": {
          "$ref": "urn:dsh:blender:common:1#/$defs/artifactId"
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approvalGrantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "action",
        "mode",
        "targetId",
        "generation"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "urn:dsh:blender:tool:blender_spec_apply:input:v1",
  "title": "blender_spec_apply v1 input",
  "$defs": {
    "opStep": {
      "$ref": "urn:dsh:blender:common:1#/$defs/sceneOp"
    }
  }
}
