{
  "type": "object",
  "properties": {
    "tool": {
      "const": "blender_project"
    },
    "action": {
      "enum": [
        "list",
        "status",
        "open",
        "reload",
        "save",
        "saveAs",
        "close"
      ]
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "project": {
          "type": "object"
        },
        "live": {
          "$ref": "urn:dsh:blender:common:1#/$defs/live"
        },
        "sceneRevision": {
          "$ref": "urn:dsh:blender:common:1#/$defs/revision"
        },
        "fileHash": {
          "$ref": "urn:dsh:blender:common:1#/$defs/digest"
        },
        "dirty": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "checkpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "saved",
            "reloaded"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "urn:dsh:blender:common:1#/$defs/evidenceId"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "effectState": {
      "enum": [
        "none",
        "partial",
        "committed",
        "unknown"
      ]
    }
  },
  "required": [
    "tool",
    "action",
    "ok",
    "data",
    "evidenceIds",
    "effectState"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh:blender:tool:blender_project:output:v1",
  "title": "blender_project v1 output"
}
