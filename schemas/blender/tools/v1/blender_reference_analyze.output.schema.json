{
  "type": "object",
  "properties": {
    "tool": {
      "const": "blender_reference_analyze"
    },
    "action": {
      "enum": [
        "analyze"
      ]
    },
    "ok": {
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resultArtifactId": {
          "$ref": "urn:dsh:blender:common:1#/$defs/artifactId"
        },
        "sha256": {
          "$ref": "urn:dsh:blender:common:1#/$defs/digest"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "completedStages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 128
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "$ref": "urn:dsh:blender:common:1#/$defs/evidenceId"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "effectState": {
      "enum": [
        "none",
        "partial",
        "committed",
        "unknown"
      ]
    }
  },
  "required": [
    "tool",
    "action",
    "ok",
    "data",
    "evidenceIds",
    "effectState"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh:blender:tool:blender_reference_analyze:output:v1",
  "title": "blender_reference_analyze v1 output"
}
